# Copy to .env and fill in. NEVER commit your real .env.

# REQUIRED in production. Generate strong random values, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SAFEWEB_PEPPER=change-me-to-a-long-random-string
SAFEWEB_SECRET=change-me-to-another-long-random-string

# Optional. Server basics.
PORT=8080
DATA_DIR=/data

# Alerts to the accountability partner.
# ALERT_TRANSPORT: console (default) | webhook | email
ALERT_TRANSPORT=console

# For ALERT_TRANSPORT=webhook (Slack/Discord/automation incoming webhook URL):
ALERT_WEBHOOK=

# For ALERT_TRANSPORT=email (Resend-compatible REST API by default):
#   EMAIL_API_URL defaults to https://api.resend.com/emails
EMAIL_API_URL=
EMAIL_API_KEY=
EMAIL_FROM=SafeWeb <alerts@yourdomain.example>
